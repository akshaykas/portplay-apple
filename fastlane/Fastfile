require "shellwords"

default_platform(:ios)

# Shared helpers for both platforms.

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
    is_key_content_base64: true
  )
end

# match exports the profile and certificate it installed as environment variables.
# Pass them to xcodebuild so the project file never needs signing details.
def signing_xcargs(platform, fallback_identity)
  bundle_id = ENV.fetch("BUNDLE_ID")
  prefix = "sigh_#{bundle_id}_appstore"
  prefix += "_#{platform}" unless platform == "ios"

  profile = ENV.fetch("#{prefix}_profile-name")
  identity = ENV["#{prefix}_certificate-name"] || fallback_identity

  [
    "CODE_SIGN_STYLE=Manual",
    "DEVELOPMENT_TEAM=#{ENV.fetch('TEAM_ID')}",
    "CODE_SIGN_IDENTITY=#{Shellwords.escape(identity)}",
    "PROVISIONING_PROFILE_SPECIFIER=#{Shellwords.escape(profile)}"
  ].join(" ")
end

platform :ios do
  desc "Sign the iPad app, build it and upload it to TestFlight"
  lane :beta do
    api_key = asc_api_key
    setup_ci

    # First run creates the distribution certificate and App Store profile.
    # Later runs download the same ones from the certificates repo.
    match(
      type: "appstore",
      platform: "ios",
      app_identifier: ENV.fetch("BUNDLE_ID"),
      api_key: api_key,
      readonly: false
    )

    build_app(
      project: "PortPlay.xcodeproj",
      scheme: "PortPlay",
      export_method: "app-store",
      output_directory: "build/ios",
      xcargs: signing_xcargs("ios", "Apple Distribution"),
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end

platform :mac do
  desc "Sign the Mac app, build it and upload it to TestFlight"
  lane :beta do
    api_key = asc_api_key
    setup_ci

    # Mac App Store uploads are .pkg installers, which need a second certificate.
    match(
      type: "appstore",
      platform: "macos",
      app_identifier: ENV.fetch("BUNDLE_ID"),
      additional_cert_types: ["mac_installer_distribution"],
      api_key: api_key,
      readonly: false
    )

    build_app(
      project: "PortPlay.xcodeproj",
      scheme: "PortPlayMac",
      export_method: "app-store",
      output_directory: "build/mac",
      xcargs: signing_xcargs("macos", "3rd Party Mac Developer Application"),
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      app_platform: "osx",
      pkg: lane_context[SharedValues::PKG_OUTPUT_PATH],
      skip_waiting_for_build_processing: true
    )
  end
end
